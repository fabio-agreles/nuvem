{
  "app-id": "app.nuvem.Nuvem",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "nuvem",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.node22",
    "org.freedesktop.Sdk.Extension.golang"
  ],
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.portal.Background",
    "--env=NUVEM_RCLONE=/app/bin/rclone"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/gir-1.0",
    "/share/vala"
  ],
  "modules": [
    "shared-modules/libayatana-appindicator/libayatana-appindicator-gtk3.json",
    {
      "name": "rclone",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/golang/bin",
        "env": {
          "GOBIN": "/app/bin",
          "GOPATH": "/run/build/rclone/go",
          "GOFLAGS": "-mod=vendor",
          "CGO_ENABLED": "0"
        }
      },
      "build-commands": [
        "mkdir -p /app/bin",
        "go build -mod=vendor -trimpath -ldflags '-s -w -X github.com/rclone/rclone/fs.Version=v1.75.2' -o rclone .",
        "install -Dm755 rclone /app/bin/rclone",
        "rclone version | head -1"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.rclone.org/v1.75.2/rclone-v1.75.2.tar.gz",
          "sha256": "fa64537e7276196310dbb0bcea6330f03b40e5790197b88f14cce6a19f40eb67"
        },
        "rclone-sources.json"
      ]
    },
    {
      "name": "nuvem",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node22/bin",
        "env": {
          "CARGO_HOME": "/run/build/nuvem/cargo",
          "CARGO_NET_OFFLINE": "true",
          "npm_config_cache": "/run/build/nuvem/flatpak-node/npm-cache",
          "npm_config_offline": "true"
        }
      },
      "cleanup": [
        "/cargo",
        "/flatpak-node"
      ],
      "build-commands": [
        "mkdir -p src-tauri/resources && touch src-tauri/resources/rclone",
        "npm ci --offline --no-audit --no-fund",
        "npm run build",
        "cargo --offline build --release --features custom-protocol --manifest-path src-tauri/Cargo.toml",
        "install -Dm755 src-tauri/target/release/nuvem /app/bin/nuvem",
        "install -Dm644 flatpak/app.nuvem.Nuvem.desktop /app/share/applications/app.nuvem.Nuvem.desktop",
        "install -Dm644 flatpak/app.nuvem.Nuvem.metainfo.xml /app/share/metainfo/app.nuvem.Nuvem.metainfo.xml",
        "install -Dm644 src-tauri/icons/128x128@2x.png /app/share/icons/hicolor/256x256/apps/app.nuvem.Nuvem.png",
        "install -Dm644 src-tauri/icons/32x32.png /app/share/icons/hicolor/32x32/apps/app.nuvem.Nuvem.png",
        "install -Dm644 src-tauri/icons/64x64.png /app/share/icons/hicolor/64x64/apps/app.nuvem.Nuvem.png",
        "install -Dm644 src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/app.nuvem.Nuvem.png",
        "install -Dm644 LICENSE /app/share/licenses/app.nuvem.Nuvem/LICENSE"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "node_modules",
            "dist",
            "src-tauri/target",
            "src-tauri/gen",
            "src-tauri/resources",
            "flatpak/repo",
            "builddir",
            ".flatpak-builder"
          ]
        },
        {
          "type": "file",
          "path": "../../LICENSE"
        },
        "cargo-sources.json",
        "node-sources.json"
      ]
    }
  ]
}
