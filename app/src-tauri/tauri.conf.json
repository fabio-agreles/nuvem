{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuvem Sync",
  "version": "1.5.1",
  "identifier": "app.nuvem.Nuvem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nuvem Sync",
        "width": 1180,
        "height": 788,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#f5f6fa"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": {
      "resources/rclone": "rclone"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "shortDescription": "Sincronize Google Drive e OneDrive",
    "longDescription": "Nuvem Sync mantém pastas deste computador em sincronização bidirecional com o Google Drive e o OneDrive, com o motor bisync do rclone embutido.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "recommends": [
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/doc/nuvem-sync/copyright": "../../LICENSE"
        },
        "desktopTemplate": "deb/nuvem.desktop",
        "replaces": [
          "nuvem (<< 1.3.0)"
        ],
        "conflicts": [
          "nuvem (<< 1.3.0)"
        ],
        "provides": [
          "nuvem"
        ]
      }
    }
  }
}
